{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mod World",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "displayName"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "environment": {
      "type": "object"
    },
    "spawnPoints": {
      "type": "array"
    }
  },
  "additionalProperties": false
}
